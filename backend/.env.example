# Copy to .env for local dev. On Railway/Render/etc, set these as dashboard
# environment variables instead — .env itself is gitignored and never deployed.

# MongoDB Atlas connection string (mongodb+srv://user:pass@cluster.mongodb.net)
MONGO_URL=
DB_NAME=jonah_wms

# Generate with: openssl rand -hex 32
JWT_SECRET=

EMERGENT_PUSH_KEY=placeholder

# Comma-separated allowed origins for CORS. Not needed when the frontend is served
# from the same origin as the API (the default setup here) — only matters if you
# split the frontend into its own separate deployment later.
CORS_ORIGINS=http://localhost:3000

# Set this explicitly for any real deployment — don't rely on the auto-generated
# password, which gets written to server logs.
ADMIN_INITIAL_PASSWORD=

# Demo workers/sites/reports seeded on first boot. MUST be false for a real deployment.
SEED_DEMO_DATA=false
